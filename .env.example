# ============================================================
# Environment variable template for cache-file-async-api
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to version control.
# ============================================================

# --- Spring Profile ---
# Active profile: dev (default) or prod
#   dev  — local-friendly defaults, verbose logging, short cleanup cron
#   prod — required DB credentials, minimal logging, 2 AM daily cleanup
SPRING_PROFILES_ACTIVE=dev

# --- MySQL ---
DB_URL=jdbc:mysql://localhost:3306/cachedb?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=yourpassword

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Application ---
SERVER_PORT=8080
UPLOAD_DIR=./uploads

# --- Optional overrides ---
# CLEANUP_CRON=0 */5 * * * *
